{
  "name": "sick-fits-frontend",
  "version": "2.0.0",
  "description": "Modern React GraphQL frontend for Sick Fits e-commerce platform",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "test": "NODE_ENV=test jest --watch",
    "test:ci": "NODE_ENV=test jest --ci",
    "type-check": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "@apollo/client": "^3.11.5",
    "date-fns": "^4.1.0",
    "downshift": "^10.1.0",
    "graphql": "^16.9.0",
    "graphql-tag": "^2.12.6",
    "lodash.debounce": "^4.0.8",
    "next": "^15.0.3",
    "nprogress": "^0.2.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-stripe-checkout": "^2.6.3",
    "react-transition-group": "^4.4.5",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.7.5",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-stripe-checkout": "^2.1.4",
    "@types/react-transition-group": "^4.4.11",
    "@types/styled-components": "^5.1.34",
    "babel-jest": "^29.7.0",
    "babel-plugin-styled-components": "^2.1.4",
    "casual": "^1.6.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
    "testPathIgnorePatterns": [
      "<rootDir>/.next/",
      "<rootDir>/node_modules/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    }
  },
  "babel": {
    "presets": [
      "next/babel"
    ],
    "plugins": [
      [
        "styled-components",
        {
          "ssr": true,
          "displayName": true
        }
      ]
    ]
  }
}
